{
  "name": "polite-media",
  "version": "0.0.0",
  "description": "Background video and images that behave themselves: reveal on the frame that actually painted, play only when visible, respect data, motion and battery.",
  "keywords": [
    "video",
    "background-video",
    "image",
    "lazy",
    "poster",
    "autoplay",
    "intersection-observer",
    "requestVideoFrameCallback",
    "performance",
    "lcp"
  ],
  "license": "MIT",
  "author": "sixra",
  "repository": "github:sixra/polite-media",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./video": {
      "types": "./dist/video.d.ts",
      "default": "./dist/video.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "default": "./dist/image.js"
    },
    "./video.css": "./dist/video.css",
    "./image.css": "./dist/image.css"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/clean.js && tsc -p tsconfig.build.json && cp src/video.css src/image.css dist/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "sh scripts/make-fixtures.sh",
    "test:e2e": "playwright test",
    "clean": "node scripts/clean.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "happy-dom": "^20.11.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
