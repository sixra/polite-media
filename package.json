{
  "name": "polite-media",
  "version": "0.0.0",
  "description": "Background video and images that behave themselves: reveal on the frame that actually painted, play only when visible, respect data, motion and battery.",
  "keywords": [
    "video",
    "background-video",
    "image",
    "lazy",
    "poster",
    "autoplay",
    "intersection-observer",
    "requestVideoFrameCallback",
    "performance",
    "lcp"
  ],
  "license": "MIT",
  "author": "sixra",
  "repository": "github:sixra/polite-media",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./video": {
      "types": "./dist/video.d.ts",
      "default": "./dist/video.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "default": "./dist/image.js"
    },
    "./video.css": "./dist/video.css",
    "./image.css": "./dist/image.css"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/clean.js && tsc -p tsconfig.build.json && esbuild src/video.css src/image.css --minify --outdir=dist",
    "clean": "node scripts/clean.js",
    "fixtures": "sh scripts/make-fixtures.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "size": "node scripts/size-check.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
